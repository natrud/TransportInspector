# transport-inspector — React Native (Expo bare)
#
# Expo reads `app.json` → `extra` — там OIDC+API configuration.
# Цей .env.example — для dev-only override.

# Example (для локального override; зазвичай використовувати app.json):
#   OIDC_AUTHORITY=TODO_OIDC_AUTHORITY
#   OIDC_CLIENT_ID=TODO_OIDC_CLIENT_ID
#   API_BASE_URL=TODO_API_URL

# Для Android emulator: 10.0.2.2 === host's localhost
# Для iOS simulator: localhost
# Для physical device: IP машини у Wi-Fi
