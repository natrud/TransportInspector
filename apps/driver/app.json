{
  "expo": {
    "name": "БЦ-Водій",
    "slug": "transport-driver",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "ua.transport.driver",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ua.transport.driver",
      "buildNumber": "1"
    },
    "android": {
      "package": "ua.transport.driver",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1b5e20"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiBaseUrl": "https://digital.bc-rada.gov.ua"
    }
  }
}
