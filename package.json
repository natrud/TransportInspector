{
  "name": "transport-inspector-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: контролерська + водійська апки громадського транспорту",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "controller:start": "pnpm --filter @transport/controller start",
    "controller:android": "pnpm --filter @transport/controller android",
    "controller:prebuild": "pnpm --filter @transport/controller prebuild",
    "driver:start": "pnpm --filter @transport/driver start",
    "driver:android": "pnpm --filter @transport/driver android",
    "driver:prebuild": "pnpm --filter @transport/driver prebuild"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.29.7",
    "@types/react": "~18.3.12",
    "typescript": "5.5.4",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
